# Скопируйте в .env.local и заполните значениями из дэшборда проекта:
# Settings -> API -> Project URL / Publishable key
# .env.local в git не попадает (см. .gitignore)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Адрес сайта — для canonical/hreflang и карты сайта (src/lib/site.ts).
# Домен выбран 2026-10-03 (docs/NAMING-2026-10.md). То же значение нужно
# задать в переменной окружения на проде.
NEXT_PUBLIC_SITE_URL=https://studypick.eu

# Только для `next dev`: показать на /match выдуманные формулы вместо подтверждённых
# MATCH_FIXTURE=1

# Политика конфиденциальности (/privacy): кто отвечает за данные и куда писать.
# Пока не заданы, страница показывает имена этих переменных вместо контактов.
# Задать до публикации (docs/PRIVACY-CHECKLIST.md). На сервере, не NEXT_PUBLIC_.
# Адрес выбран 2026-10-09: studypickeu@gmail.com (docs/PRIVACY-CHECKLIST.md).
# PRIVACY_CONTROLLER_NAME=Имя Фамилия или название предприятия
# PRIVACY_CONTACT_EMAIL=privacy@ваш-домен

# Ссылка «Pamanīji kļūdu? Raksti mums» на карточке программы и в калькуляторе
# (src/lib/report.ts): куда приходят письма об ошибках. Если не задан —
# берётся PRIVACY_CONTACT_EMAIL; если не задан ни один — ссылки на сайте нет.
# FEEDBACK_EMAIL=kludas@ваш-домен

# На настоящем хостинге (когда выбран) — включает проверку перед сборкой
# (scripts/check-privacy-env.mjs): без двух переменных выше сборка падает,
# а не публикуется с плейсхолдером вместо оператора данных. Здесь и в
# CI не ставить — так проверка ничего не ломает локально.
# PRIVACY_ENFORCE=1

# Страны, которые ещё строятся (сейчас — Литва: адреса /lt, /en-lt, /lv-lt).
# Латвийский каталог на литовском (/lt-lv) от этого флага не зависит.
# Без этой переменной их адреса отдают 404, их нет в карте сайта. Ставится
# только локально и на тестовой выкладке; на рабочем сайте — нет, пока
# страна не запущена (src/i18n/config.ts).
# NEXT_PUBLIC_PREVIEW_COUNTRIES=1

# Счётчик посещений (PostHog, серверы в ЕС). Публичный ключ проекта (phc_…) с
# eu.posthog.com — не личный ключ (phx_…). Считает только рабочий сайт: при
# разработке и на localhost события не уходят (src/lib/analytics.ts). На
# площадке задаётся вместе с PRIVACY_CONTROLLER_NAME и PRIVACY_CONTACT_EMAIL —
# без них сборка с этим ключом падает (scripts/check-privacy-env.mjs).
# NEXT_PUBLIC_POSTHOG_KEY=

# Закрытая выкладка: сайт стоит на домене, но поисковикам запрещён (robots.txt и
# noindex на каждой странице). Ставится на сервере до дня запуска, локально не
# нужна. С ней нельзя задавать NEXT_PUBLIC_POSTHOG_KEY — сборка упадёт.
# SITE_CLOSED=1
