# Настройки сайта на сервере. Скопировать в /etc/studypick/env и заполнить.
# Файл читают и сборка (deploy/update.sh), и работающий сайт
# (deploy/studypick.service) — значения должны быть одни и те же.
#
# Формат: ИМЯ=значение, по одной на строку. Значение с пробелом — в кавычках.
# Секретов здесь нет: служебный ключ базы (service role) на сервер сайта
# НЕ кладётся, он нужен только сборщикам данных.

# Адрес базы и публичный ключ — те же, что в вашем .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Адрес сайта: по нему строятся canonical, hreflang и карта сайта.
NEXT_PUBLIC_SITE_URL=https://studypick.eu

# Политика конфиденциальности: кто отвечает за данные и куда писать.
PRIVACY_CONTROLLER_NAME="Vasilijs Spizevojs"
PRIVACY_CONTACT_EMAIL=studypickeu@gmail.com
# Без двух строк выше сборка остановится — так и задумано.
PRIVACY_ENFORCE=1

# Закрытая выкладка: поисковикам запрещено, на страницах noindex.
# В день запуска эту строку убрать (deploy/README.md, «День запуска»).
SITE_CLOSED=1

# Счётчик посещений. Пока сайт закрыт — НЕ задавать: сборка с SITE_CLOSED=1
# и этим ключом остановится. Включается в день запуска.
# NEXT_PUBLIC_POSTHOG_KEY=

# Показать Литву до её запуска (решение владельца 2026-10-10). Допустимо
# ТОЛЬКО вместе с SITE_CLOSED=1: за паролем её видите вы и участники закрытой
# проверки. В день запуска строку убрать — сборка открытого сайта с ней
# остановится сама (deploy/README.md, «День запуска»).
# NEXT_PUBLIC_PREVIEW_COUNTRIES=1

# Чего здесь быть не должно:
#   SUPABASE_SERVICE_ROLE_KEY — служебный ключ базы.
