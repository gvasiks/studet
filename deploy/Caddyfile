# Веб-сервер Caddy: принимает запросы из интернета, сам получает и
# продлевает сертификат HTTPS и передаёт запросы сайту на 127.0.0.1:3000.
# Положить в /etc/caddy/Caddyfile (deploy/README.md, шаг 6).
#
# Сертификат Caddy получит, только когда домен уже указывает на этот сервер.

www.studypick.eu {
	redir https://studypick.eu{uri} permanent
}

studypick.eu {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	# Журнал запросов (IP, время, адрес, браузер) — для безопасности сайта.
	# Хранится 14 дней: старые файлы удаляет logrotate (deploy/logrotate-studypick,
	# deploy/README.md, шаг 6). Своя ротация Caddy режет файл только по
	# размеру, поэтому выключена. Срок записан в политике конфиденциальности
	# (раздел «visit», решение владельца 2026-10-15): меняя его, правьте и её.
	log {
		output file /var/log/caddy/studypick-access.log {
			roll_disabled
		}
	}

	# Пароль на время закрытой выкладки. Чтобы включить: получить строку
	# командой `caddy hash-password`, подставить её вместо ХЕШ, убрать три
	# решётки ниже и выполнить `systemctl reload caddy`. В день запуска —
	# вернуть решётки. (В Caddy 2.6 из Ubuntu директива пишется слитно:
	# basicauth.)
	#
	# basicauth {
	# 	studypick ХЕШ
	# }
}
