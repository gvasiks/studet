# Скопируйте в .env. Тот же проект, что и в ../.env.local, но другой ключ:
# service_role, не anon — он обходит RLS, поэтому живёт только здесь,
# никогда не в Next.js (CLAUDE.md, A02). Берётся в дэшборде:
# Settings -> API -> service_role secret.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Вежливый обход источников (см. src/polite.py). Контакт попадает в User-Agent
# и виден администраторам сайтов вузов — укажите URL страницы о проекте или
# рабочую почту, не личную.
SCRAPER_CONTACT=
# Необязательно: пауза между страницами одного домена, секунды (по умолчанию 1.5;
# Crawl-delay из robots.txt, если он больше, имеет приоритет).
# SCRAPE_DELAY_SECONDS=1.5
# Необязательно, только для отладки: 1 — кэшировать страницы на сутки в .cache/.
# SCRAPE_CACHE=1
# Необязательно, только для отладки: 0 — не смотреть в robots.txt.
# SCRAPE_OBEY_ROBOTS=0eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
