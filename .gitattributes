# Копии документов-источников хранятся байт в байт: их хэш записан в базе
# (formula.source_copy_sha256), перевод строк при выгрузке его бы изменил
docs/source-documents/** -text

# Файлы для сервера (Linux) — всегда с переводом строки LF, в том числе в
# рабочей копии на Windows: скрипт с CRLF на сервере не запустится.
deploy/** text eol=lf
